{
    "name": "murkrow/pdf-utils",
    "description": "A poppler-utils wrapper for Laravel applications",
    "keywords": [
        "pdf",
        "laravel",
        "pdf-utils",
        "popper-utils",
        "murkrow"
    ],
    "homepage": "https://github.com/Murkrow02/pdf-utils",
    "license": "MIT",
    "authors": [
        {
            "name": "murkrow",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Murkrow\\PdfUtils\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/framework": "^12.0 || ^13.0",
        "spatie/temporary-directory": "^2.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
